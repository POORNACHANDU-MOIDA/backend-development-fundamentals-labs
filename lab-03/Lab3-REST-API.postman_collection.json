    {
      "name": "10. POST Create Book (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const json = pm.response.json();",
              "if (json && json.bookId) {",
              "    pm.collectionVariables.set('createdBookId', String(json.bookId));",
              "    console.log('Saved createdBookId:', json.bookId);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Site Reliability Engineering\",\n  \"author\": \"Betsy Beyer, Chris Jones, Jennifer Petoff, Niall Richard Murphy\",\n  \"price\": 720,\n  \"pages\": 550\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "http://localhost:3000/books/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""]
        },
        "description": "Creates a new book and dynamically binds createdBookId."
      },
      "response": []
    },
